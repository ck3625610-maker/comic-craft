# Copy this file to .env
GEMINI_API_KEY=your_gemini_api_key_here
HF_TOKEN=your_huggingface_token_here

# Current Gemini text model. You can change this without editing code.
GEMINI_MODEL=gemini-3.8-flash

# Hugging Face text-to-image model.
HF_MODEL=stabilityai/stable-diffusion-2-1

# auto = use Hugging Face when HF_TOKEN exists; otherwise generate a local placeholder.
IMAGE_MODE=auto

# Number of comic panels to generate (2-6).
DEFAULT_PANELS=4
